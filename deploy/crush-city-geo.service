[Unit]
Description=Crush City real map API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/city.xedoc.ru
ExecStart=/usr/bin/node --max-old-space-size=512 /var/www/city.xedoc.ru/current/.server/geo-server.mjs
Environment=PORT=5190
Environment=GEO_CACHE_DIR=/var/cache/crush-city-geo
EnvironmentFile=-/etc/default/crush-city-geo
CacheDirectory=crush-city-geo
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
